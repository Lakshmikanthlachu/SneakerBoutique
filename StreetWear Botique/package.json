{
  "name": "kairos-html-template",
  "version": "1.0.0",
  "description": "KAIROS — Sneaker & Streetwear Boutique HTML template (Tailwind CSS, dark/light, RTL, 3D effects)",
  "private": true,
  "scripts": {
    "build": "npm run build:css && node scripts/build-public.mjs",
    "build:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --minify",
    "dev:css": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch",
    "build:dev": "tailwindcss -i ./src/input.css -o ./assets/css/style.css",
    "watch": "tailwindcss -i ./src/input.css -o ./assets/css/style.css --watch"
  },
  "devDependencies": {
    "tailwindcss": "3.4.17"
  },
  "license": "SEE LICENSE IN README.md",
  "engines": {
    "node": ">=18"
  }
}
